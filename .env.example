# LLM API 配置
LLM_API_URL=https://api.deepseek.com/v1/chat/completions
LLM_API_KEY=replace-with-your-api-key
LLM_MODEL=deepseek-chat

# DeepSeek 前端 API 配置

# MySQL 持久化配置
MYSQL_HOST=127.0.0.1
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=edumind
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=edumind
MYSQL_POOL_SIZE=10
