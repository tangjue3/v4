# Copy this file to .env on the server. Never upload the local development .env.
APP_PORT=8255

MYSQL_DATABASE=edumind
MYSQL_USER=edumind_app
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
MYSQL_POOL_SIZE=10

LLM_API_URL=https://api.deepseek.com/v1/chat/completions
LLM_API_KEY=replace-with-your-server-side-api-key
LLM_MODEL=deepseek-chat
